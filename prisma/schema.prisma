generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserActorStatus {
  ACTIVE
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum ProductProjectStatus {
  DRAFT
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum SourceSnapshotKind {
  PRODUCT_SOURCE
  PRODUCT_REFERENCE
  BRAND_REFERENCE
  LOGO_REFERENCE
  OTHER_REFERENCE
}

enum SourceSnapshotValidationStatus {
  PENDING
  VALID
  ACTION_REQUIRED
  INVALID
}

enum SourceSnapshotLifecycleStatus {
  ACTIVE
  DELETED
}

enum ProductTruthContinuity {
  SAME_PRODUCT
  DIFFERENT_PRODUCT
  REVIEW_REQUIRED
}

enum ProductTruthRevisionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  INVALIDATED
}

enum TruthRevisionSourceRole {
  PRODUCT_PRIMARY
  PRODUCT_SUPPORTING
}

enum TruthRevisionLinkStatus {
  ACTIVE
  INVALIDATED
}

enum P2IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
}

enum AssetTaskType {
  INTERNAL_SINGLE_IMAGE
}

enum AssetClass {
  IMAGE
}

enum AssetTaskOutputPurpose {
  INTERNAL_TEST
}

enum AssetTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  HARD_BLOCKED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetKind {
  PRODUCT
  REFERENCE
  GENERATED_BACKGROUND
  EXPORT
}

enum JobType {
  STYLE_ANALYSIS
  IMAGE_GENERATION
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum BenchmarkVariant {
  PLAIN_PROMPT
  STYLE_SPEC
}

enum BenchmarkJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProviderSubmissionState {
  NOT_STARTED
  SUBMITTING
  SUBMITTED
  AMBIGUOUS
  COMPLETED
}

model UserActor {
  userActorId       String          @id @default(cuid())
  authIssuer        String
  authSubject       String
  status            UserActorStatus
  disabledAt        DateTime?
  createdAt         DateTime        @default(now())
  createdWorkspaces Workspace[]     @relation("WorkspaceCreator")
  memberships       Membership[]    @relation("MembershipActor")
  revokedMemberships Membership[]   @relation("MembershipRevoker")
  p2AuthSessions     P2AuthSession[]

  @@unique([authIssuer, authSubject])
}

model P2AuthVerificationToken {
  identifier String
  tokenHash  String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@id([identifier, tokenHash])
}

model P2AuthSession {
  sessionToken String    @id
  userActorId  String
  expires      DateTime
  createdAt    DateTime  @default(now())
  userActor    UserActor @relation(fields: [userActorId], references: [userActorId], onDelete: Restrict, onUpdate: Cascade)

  @@index([userActorId, expires])
}

model Workspace {
  workspaceId      String          @id @default(cuid())
  displayName      String
  status           WorkspaceStatus
  createdByActorId String
  suspendedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  createdByActor   UserActor       @relation("WorkspaceCreator", fields: [createdByActorId], references: [userActorId], onDelete: Restrict, onUpdate: Cascade)
  memberships      Membership[]
  productProjects  ProductProject[]
  p2IdempotencyRecords P2IdempotencyRecord[]

  @@index([createdByActorId])
}

model Membership {
  membershipId     String           @id @default(cuid())
  workspaceId      String
  userActorId      String
  role             MembershipRole
  status           MembershipStatus
  revokedAt        DateTime?
  revokedByActorId String?
  createdAt        DateTime         @default(now())
  workspace        Workspace        @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict, onUpdate: Cascade)
  userActor        UserActor        @relation("MembershipActor", fields: [userActorId], references: [userActorId], onDelete: Restrict, onUpdate: Cascade)
  revokedByActor   UserActor?       @relation("MembershipRevoker", fields: [revokedByActorId], references: [userActorId], onDelete: Restrict, onUpdate: Cascade)
  createdProductProjects ProductProject[] @relation("ProductProjectCreatorMembership")
  createdSourceSnapshots SourceSnapshot[] @relation("SourceSnapshotCreatorMembership")
  createdProductTruthRevisions ProductTruthRevision[] @relation("ProductTruthRevisionCreatorMembership")
  createdTruthRevisionSourceLinks TruthRevisionSourceLink[] @relation("TruthRevisionSourceLinkCreatorMembership")
  createdAssetTasks AssetTask[] @relation("AssetTaskCreatorMembership")
  p2DomainEvents P2DomainEvent[] @relation("P2DomainEventActorMembership")
  p2IdempotencyRecords P2IdempotencyRecord[] @relation("P2IdempotencyActorMembership")

  @@unique([workspaceId, userActorId])
  @@index([userActorId, status])
  @@index([revokedByActorId])
  back_GenerationAttemptSourceLink_scope_creator_fkey GenerationAttemptSourceLink[] @relation("GenerationAttemptSourceLink_scope_creator_fkey")
  back_Artifact_scope_creator_fkey Artifact[] @relation("Artifact_scope_creator_fkey")
  back_Artifact_scope_deletedBy_fkey Artifact[] @relation("Artifact_scope_deletedBy_fkey")
  back_ArtifactRevision_scope_creator_fkey ArtifactRevision[] @relation("ArtifactRevision_scope_creator_fkey")
  back_ArtifactRevisionSourceLink_scope_creator_fkey ArtifactRevisionSourceLink[] @relation("ArtifactRevisionSourceLink_scope_creator_fkey")
}

model ProductProject {
  projectId         String               @id
  workspaceId       String
  skuIdentityKey    String
  displayName       String
  status            ProductProjectStatus
  activeTruthRevisionId String?
  createdByActorId  String
  archivedAt        DateTime?
  createdAt         DateTime             @default(now())
  workspace         Workspace            @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict, onUpdate: Cascade)
  creatorMembership Membership           @relation("ProductProjectCreatorMembership", fields: [workspaceId, createdByActorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade)
  sourceSnapshots   SourceSnapshot[]
  truthRevisions    ProductTruthRevision[] @relation("ProductProjectTruthRevisions")
  activeTruthRevision ProductTruthRevision? @relation("ActiveProductTruthRevision", fields: [workspaceId, projectId, activeTruthRevisionId], references: [workspaceId, projectId, productTruthRevisionId], onDelete: Restrict, onUpdate: Cascade)
  assetTasks         AssetTask[]
  p2DomainEvents    P2DomainEvent[]
  p2IdempotencyRecords P2IdempotencyRecord[]

  @@unique([workspaceId, projectId])
  @@unique([workspaceId, skuIdentityKey])
  @@index([workspaceId, status, createdAt])
  @@index([createdByActorId])
}

model SourceSnapshot {
  sourceSnapshotId  String                         @id
  workspaceId       String
  projectId         String
  sourceKind        SourceSnapshotKind
  mediaType         String
  byteSize          BigInt
  contentDigest     String
  storageLocator    String
  validationStatus  SourceSnapshotValidationStatus
  lifecycleStatus   SourceSnapshotLifecycleStatus
  capturedAt        DateTime                       @default(now())
  createdByActorId  String
  productProject    ProductProject                 @relation(fields: [workspaceId, projectId], references: [workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade)
  creatorMembership Membership                     @relation("SourceSnapshotCreatorMembership", fields: [workspaceId, createdByActorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade)
  truthRevisionSourceLinks TruthRevisionSourceLink[]
  assetTasks         AssetTask[]                    @relation("AssetTaskProductSource")

  @@unique([workspaceId, projectId, sourceSnapshotId])
  @@index([workspaceId, projectId, capturedAt])
  @@index([workspaceId, projectId, contentDigest])
  @@index([createdByActorId])
  @@unique([workspaceId, projectId, sourceSnapshotId, contentDigest], map: "SourceSnapshot_scope_id_contentDigest_key")
  back_GenerationAttemptSourceLink_scope_source_digest_fkey GenerationAttemptSourceLink[] @relation("GenerationAttemptSourceLink_scope_source_digest_fkey")
  back_ArtifactRevisionSourceLink_scope_source_digest_fkey ArtifactRevisionSourceLink[] @relation("ArtifactRevisionSourceLink_scope_source_digest_fkey")
}

model ProductTruthRevision {
  productTruthRevisionId String                     @id
  workspaceId            String
  projectId              String
  revisionNumber         Int
  truthBody              Json
  productContinuity      ProductTruthContinuity
  status                 ProductTruthRevisionStatus
  parentRevisionId       String?
  createdByActorId       String
  activatedAt            DateTime?
  supersededAt           DateTime?
  invalidatedAt          DateTime?
  createdAt              DateTime                   @default(now())
  productProject         ProductProject             @relation("ProductProjectTruthRevisions", fields: [workspaceId, projectId], references: [workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade)
  activeForProjects      ProductProject[]           @relation("ActiveProductTruthRevision")
  parentRevision         ProductTruthRevision?      @relation("ProductTruthRevisionParent", fields: [workspaceId, projectId, parentRevisionId], references: [workspaceId, projectId, productTruthRevisionId], onDelete: Restrict, onUpdate: Cascade)
  childRevisions         ProductTruthRevision[]     @relation("ProductTruthRevisionParent")
  creatorMembership      Membership                 @relation("ProductTruthRevisionCreatorMembership", fields: [workspaceId, createdByActorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade)
  sourceLinks            TruthRevisionSourceLink[]
  assetTasks             AssetTask[]                @relation("AssetTaskTruthRevision")

  @@unique([workspaceId, projectId, productTruthRevisionId])
  @@unique([workspaceId, projectId, revisionNumber])
  @@index([workspaceId, projectId, status, revisionNumber])
  @@index([createdByActorId])
  @@index([parentRevisionId])
}

model TruthRevisionSourceLink {
  linkId                 String                   @id
  workspaceId            String
  projectId              String
  productTruthRevisionId String
  sourceSnapshotId       String
  sourceRole             TruthRevisionSourceRole
  sortOrder              Int
  linkStatus             TruthRevisionLinkStatus
  createdByActorId       String
  createdAt              DateTime                 @default(now())
  productTruthRevision   ProductTruthRevision     @relation(fields: [workspaceId, projectId, productTruthRevisionId], references: [workspaceId, projectId, productTruthRevisionId], onDelete: Restrict, onUpdate: Cascade)
  sourceSnapshot         SourceSnapshot           @relation(fields: [workspaceId, projectId, sourceSnapshotId], references: [workspaceId, projectId, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade)
  creatorMembership      Membership               @relation("TruthRevisionSourceLinkCreatorMembership", fields: [workspaceId, createdByActorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productTruthRevisionId, sourceSnapshotId])
  @@unique([productTruthRevisionId, sortOrder])
  @@index([workspaceId, projectId, sourceSnapshotId])
  @@index([createdByActorId])
}

model AssetTask {
  assetTaskId            String                 @id
  workspaceId            String
  projectId              String
  taskType                AssetTaskType
  assetClass              AssetClass
  outputPurpose           AssetTaskOutputPurpose
  truthRevisionId         String
  productSourceSnapshotId String
  status                   AssetTaskStatus
  createdByActorId        String
  createdAt               DateTime               @default(now())
  productProject          ProductProject         @relation(fields: [workspaceId, projectId], references: [workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade, map: "AssetTask_scope_project_fkey")
  truthRevision           ProductTruthRevision   @relation("AssetTaskTruthRevision", fields: [workspaceId, projectId, truthRevisionId], references: [workspaceId, projectId, productTruthRevisionId], onDelete: Restrict, onUpdate: Cascade, map: "AssetTask_scope_truthRevision_fkey")
  productSourceSnapshot   SourceSnapshot         @relation("AssetTaskProductSource", fields: [workspaceId, projectId, productSourceSnapshotId], references: [workspaceId, projectId, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "AssetTask_scope_productSource_fkey")
  creatorMembership       Membership             @relation("AssetTaskCreatorMembership", fields: [workspaceId, createdByActorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade, map: "AssetTask_scope_creator_fkey")

  @@unique([workspaceId, projectId, assetTaskId], map: "AssetTask_scope_id_key")
  @@index([workspaceId, projectId, status, createdAt], map: "AssetTask_scope_status_createdAt_idx")
  @@index([workspaceId, projectId, truthRevisionId], map: "AssetTask_scope_truthRevision_idx")
  @@index([workspaceId, projectId, productSourceSnapshotId], map: "AssetTask_scope_productSource_idx")
  @@index([createdByActorId])
  currentArtifactRevisionId String?
  startedAt DateTime? @db.Timestamp(3)
  finishedAt DateTime? @db.Timestamp(3)
  failureCode String?
  @@index([workspaceId, projectId, currentArtifactRevisionId], map: "AssetTask_scope_currentArtifactRevision_idx")
  @@unique([workspaceId, projectId, assetTaskId, truthRevisionId], map: "AssetTask_scope_id_truthRevision_key")
  @@unique([workspaceId, projectId, assetTaskId, productSourceSnapshotId], map: "AssetTask_scope_id_source_key")
  back_GenerationAttempt_scope_task_truth_fkey GenerationAttempt[] @relation("GenerationAttempt_scope_task_truth_fkey")
  back_GenerationAttemptSourceLink_scope_task_source_fkey GenerationAttemptSourceLink[] @relation("GenerationAttemptSourceLink_scope_task_source_fkey")
  back_Artifact_scope_task_fkey Artifact? @relation("Artifact_scope_task_fkey")
  rel_AssetTask_current_artifact_revision_direct_fkey ArtifactRevision? @relation("AssetTask_current_artifact_revision_direct_fkey", fields: [workspaceId, projectId, assetTaskId, currentArtifactRevisionId], references: [workspaceId, projectId, assetTaskId, artifactRevisionId], onDelete: Restrict, onUpdate: Cascade, map: "AssetTask_current_artifact_revision_direct_fkey")
  rel_AssetTask_current_selected_equivalence_fkey Artifact? @relation("AssetTask_current_selected_equivalence_fkey", fields: [workspaceId, projectId, assetTaskId, currentArtifactRevisionId], references: [workspaceId, projectId, assetTaskId, selectedArtifactRevisionId], onDelete: Restrict, onUpdate: Cascade, map: "AssetTask_current_selected_equivalence_fkey")
}

model P2DomainEvent {
  eventId            String         @id
  eventType          String
  eventSchemaVersion Int
  occurredAt         DateTime       @default(now())
  workspaceId        String
  projectId          String
  actorType          String
  actorId            String
  requestId          String
  correlationId      String
  sourceCommit       String
  productVersion     String
  eventBody          Json
  productProject     ProductProject @relation(fields: [workspaceId, projectId], references: [workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade)
  actorMembership    Membership     @relation("P2DomainEventActorMembership", fields: [workspaceId, actorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade)

  @@index([workspaceId, projectId, occurredAt])
  @@index([workspaceId, requestId])
  @@index([actorId])
}

model P2IdempotencyRecord {
  idempotencyRecordId String              @id
  workspaceId        String
  projectId          String
  actorId            String
  operation          String
  idempotencyKey     String
  requestFingerprint String
  status             P2IdempotencyStatus
  responseStatus     Int?
  responseBody       Json?
  createdAt          DateTime            @default(now())
  completedAt        DateTime?
  workspace          Workspace           @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict, onUpdate: Cascade)
  productProject     ProductProject      @relation(fields: [workspaceId, projectId], references: [workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade)
  actorMembership    Membership          @relation("P2IdempotencyActorMembership", fields: [workspaceId, actorId], references: [workspaceId, userActorId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, projectId, createdAt])
  @@index([actorId])
}

model Project {
  id                 String              @id @default(cuid())
  ownerId            String
  name               String
  status             ProjectStatus       @default(DRAFT)
  productName        String
  category           String
  sellingPoints      String[]
  targetAudience     String?
  forbiddenClaims    String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assets             Asset[]
  styleSpecRevisions StyleSpecRevision[]
  jobs               Job[]
  generationResults  GenerationResult[]
  designVersions     DesignVersion[]
  exports            Export[]
  benchmarkRuns      BenchmarkRun[]
  benchmarkJobs      BenchmarkJob[]
  benchmarkResults   BenchmarkResult[]

  @@index([ownerId])
}

model Asset {
  id                    String            @id @default(cuid())
  ownerId               String
  projectId             String
  kind                  AssetKind
  objectKey             String            @unique
  mimeType              String
  byteSize              BigInt
  width                 Int
  height                Int
  sha256                String
  sourceAssetId         String?
  createdAt             DateTime          @default(now())
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAsset           Asset?            @relation("AssetSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  derivedAssets         Asset[]           @relation("AssetSource")
  generationResult      GenerationResult?
  designVersionPreviews DesignVersion[]   @relation("DesignVersionPreview")
  exports               Export[]
  benchmarkProductRuns  BenchmarkRun[]    @relation("BenchmarkProductAsset")
  benchmarkResults      BenchmarkResult[]

  @@index([ownerId, projectId])
  @@index([sourceAssetId])
}

model StyleSpecRevision {
  id                String             @id @default(cuid())
  ownerId           String
  projectId         String
  revisionNumber    Int
  schemaVersion     String
  specJson          Json
  createdAt         DateTime           @default(now())
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs              Job[]
  generationResults GenerationResult[]
  designVersions    DesignVersion[]
  benchmarkRuns     BenchmarkRun[]

  @@unique([projectId, revisionNumber])
  @@index([ownerId, projectId])
}

model BenchmarkRun {
  id                    String            @id @default(cuid())
  ownerId               String
  projectId             String
  idempotencyKey        String
  experimentFingerprint String
  sku                   String
  providerName          String
  modelName             String
  outputWidth           Int
  outputHeight          Int
  productAssetId        String
  referenceAssetIds     String[]
  styleSpecRevisionId   String
  generationContextJson Json
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productAsset          Asset             @relation("BenchmarkProductAsset", fields: [productAssetId], references: [id], onDelete: Restrict)
  styleSpecRevision     StyleSpecRevision @relation(fields: [styleSpecRevisionId], references: [id], onDelete: Restrict)
  jobs                  BenchmarkJob[]

  @@unique([projectId, idempotencyKey])
  @@unique([projectId, experimentFingerprint])
  @@index([ownerId, projectId, createdAt])
  @@index([productAssetId])
  @@index([styleSpecRevisionId])
}

model BenchmarkJob {
  id                      String                  @id @default(cuid())
  ownerId                 String
  projectId               String
  benchmarkRunId          String
  variant                 BenchmarkVariant
  status                  BenchmarkJobStatus      @default(QUEUED)
  inputJson               Json
  providerName            String
  providerRequestId       String?
  errorCode               String?
  errorMessage            String?
  attemptCount            Int                     @default(0)
  maxAttempts             Int                     @default(2)
  lockedAt                DateTime?
  leaseToken              String?
  providerInvocationKey   String?                 @unique
  providerSubmissionState ProviderSubmissionState @default(NOT_STARTED)
  providerSubmittedAt     DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  benchmarkRun            BenchmarkRun            @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)
  result                  BenchmarkResult?

  @@unique([benchmarkRunId, variant])
  @@index([ownerId, projectId])
  @@index([status, createdAt])
  @@index([status, lockedAt])
}

model BenchmarkResult {
  id                String       @id @default(cuid())
  ownerId           String
  projectId         String
  benchmarkJobId    String       @unique
  assetId           String       @unique
  providerName      String
  providerRequestId String
  requestId         String
  durationMs        Int
  usageJson         Json
  costMetadataJson  Json
  createdAt         DateTime     @default(now())
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  benchmarkJob      BenchmarkJob @relation(fields: [benchmarkJobId], references: [id], onDelete: Cascade)
  asset             Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([ownerId, projectId])
}

model Job {
  id                      String                  @id @default(cuid())
  ownerId                 String
  projectId               String
  type                    JobType
  status                  JobStatus               @default(QUEUED)
  idempotencyKey          String?
  inputJson               Json                    @default("{}")
  styleSpecRevisionId     String?
  providerName            String?
  providerRequestId       String?
  errorCode               String?
  errorMessage            String?
  attemptCount            Int                     @default(0)
  maxAttempts             Int                     @default(2)
  lockedAt                DateTime?
  leaseToken              String?
  providerInvocationKey   String?                 @unique
  providerSubmissionState ProviderSubmissionState @default(NOT_STARTED)
  providerSubmittedAt     DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  styleSpecRevision       StyleSpecRevision?      @relation(fields: [styleSpecRevisionId], references: [id], onDelete: SetNull)
  generationResult        GenerationResult?

  @@unique([projectId, type, idempotencyKey])
  @@index([ownerId, projectId])
  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([styleSpecRevisionId])
}

model GenerationResult {
  id                  String            @id @default(cuid())
  ownerId             String
  projectId           String
  jobId               String            @unique
  assetId             String            @unique
  styleSpecRevisionId String
  providerName        String
  providerRequestId   String
  requestId           String
  durationMs          Int
  usageJson           Json
  costMetadataJson    Json
  createdAt           DateTime          @default(now())
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  styleSpecRevision   StyleSpecRevision @relation(fields: [styleSpecRevisionId], references: [id], onDelete: Restrict)

  @@index([ownerId, projectId])
  @@index([styleSpecRevisionId])
}

model DesignVersion {
  id                  String            @id @default(cuid())
  ownerId             String
  projectId           String
  versionNumber       Int
  styleSpecRevisionId String
  canvasWidth         Int
  canvasHeight        Int
  documentJson        Json
  previewAssetId      String?
  createdAt           DateTime          @default(now())
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  styleSpecRevision   StyleSpecRevision @relation(fields: [styleSpecRevisionId], references: [id], onDelete: Restrict)
  previewAsset        Asset?            @relation("DesignVersionPreview", fields: [previewAssetId], references: [id], onDelete: SetNull)
  exports             Export[]

  @@unique([projectId, versionNumber])
  @@index([ownerId, projectId])
  @@index([styleSpecRevisionId])
  @@index([previewAssetId])
}

model Export {
  id              String        @id @default(cuid())
  ownerId         String
  projectId       String
  designVersionId String
  assetId         String        @unique
  createdAt       DateTime      @default(now())
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designVersion   DesignVersion @relation(fields: [designVersionId], references: [id], onDelete: Cascade)
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([ownerId, projectId])
  @@index([designVersionId])
}

enum GenerationAttemptTrigger {
  INITIAL
  AUTO_REDO
  USER_REDO
}

enum GenerationAttemptProvider {
  INTERNAL_TEST
}

enum GenerationAttemptExecutorKind {
  INTERNAL_TEST_PNG_V1
}

enum GenerationAttemptStatus {
  QUEUED
  SUBMITTING
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  AMBIGUOUS
}

enum ArtifactLifecycleStatus {
  ACTIVE
  DELETED
}

enum ArtifactRevisionOrigin {
  PROVIDER
  SYSTEM_LAYOUT
  USER_EDIT
  PLATFORM_DERIVATION
}

enum ArtifactRevisionStatus {
  CANDIDATE
  ACCEPTED
  REJECTED
  SUPERSEDED
  REVOKED
}

enum P2SourceLineageRole {
  PRODUCT_SOURCE
}

enum P2SourceLineageStatus {
  ACTIVE
  INVALIDATED
}

model GenerationAttempt {
  generationAttemptId String @id
  workspaceId String
  projectId String
  assetTaskId String
  trigger GenerationAttemptTrigger @default(INITIAL)
  autoRedoOrdinal Int @default(0)
  idempotencyKey String
  inputFingerprint String
  truthRevisionId String
  brandKitRevisionId String?
  visualPlanId String?
  provider GenerationAttemptProvider @default(INTERNAL_TEST)
  model String
  promptVersion String
  executorKind GenerationAttemptExecutorKind
  status GenerationAttemptStatus
  transportRetryCount Int @default(0)
  providerRequestId String?
  errorCode String?
  usageBody Json?
  costBody Json?
  startedAt DateTime? @db.Timestamp(3)
  finishedAt DateTime? @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  @@unique([workspaceId, projectId, generationAttemptId], map: "GenerationAttempt_scope_id_key")
  @@unique([workspaceId, projectId, assetTaskId, generationAttemptId], map: "GenerationAttempt_scope_task_id_key")
