# Copy this file to .env for local development. Values below are local-only examples.
DATABASE_URL=postgresql://image_generation:image_generation@127.0.0.1:5432/image_generation
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=image-generation-mvp
S3_ACCESS_KEY_ID=local-development-key
S3_SECRET_ACCESS_KEY=local-development-secret
S3_FORCE_PATH_STYLE=true
MVP_DEMO_USER_ID=local-demo-user
STYLE_ANALYZER_PROVIDER=mock
STYLE_ANALYZER_MOCK_SCENARIO=success
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_MOCK_SCENARIO=success
