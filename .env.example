# Copy this file to .env for local development. Values below are local-only examples.
DATABASE_URL=postgresql://image_generation:image_generation@127.0.0.1:5432/image_generation
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=image-generation-mvp
S3_ACCESS_KEY_ID=local-development-key
S3_SECRET_ACCESS_KEY=local-development-secret
S3_FORCE_PATH_STYLE=true
MVP_DEMO_USER_ID=local-demo-user
STYLE_ANALYZER_PROVIDER=mock
STYLE_ANALYZER_MOCK_SCENARIO=success
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_MOCK_SCENARIO=success
# For a real product-reference run, change IMAGE_GENERATION_PROVIDER to qwen.
# Required only when IMAGE_GENERATION_PROVIDER=qwen. Never commit a real key.
# Supported endpoints: dashscope.aliyuncs.com, Beijing workspace, or Singapore workspace.
# QWEN_API_KEY and QWEN_ENDPOINT must belong to the same region.
QWEN_API_KEY=
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# The configured model must support Qwen Image generation and image editing.
QWEN_MODEL=qwen-image-2.0
QWEN_TIMEOUT_MS=180000
